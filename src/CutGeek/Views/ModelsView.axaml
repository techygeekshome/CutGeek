<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CutGeek.ViewModels"
             x:Class="CutGeek.Views.ModelsView"
             x:DataType="vm:ShellViewModel">

  <ScrollViewer>
    <StackPanel Margin="26,20" Spacing="16">

      <Border Classes="band">
        <StackPanel Spacing="6">
          <TextBlock Text="Why nothing is included in the installer" FontWeight="SemiBold" FontSize="13.5" />
          <TextBlock Classes="sub" MaxWidth="780" HorizontalAlignment="Left"
                     Text="The good models are about 176 MB each and most people only ever use one, so CutGeek fetches the one you pick, once, and keeps it. This is the only thing the app ever downloads, and it only happens when you press the button. Every download is checked against the hash below and deleted if it does not match, so CutGeek runs the exact file it was tested with or it runs nothing at all." />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel>
          <Border Classes="cardhead">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="Models" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Classes="meta" VerticalAlignment="Center"
                         Text="U^2-Net and IS-Net, both Apache-2.0" />
            </Grid>
          </Border>

          <ItemsControl ItemsSource="{Binding Models}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ModelRowViewModel">
                <Border Classes="row">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" />
                      <TextBlock Text="{Binding SizeText}" Classes="mono" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Blurb}" Classes="sub"
                               Margin="0,3,0,0" MaxWidth="600" HorizontalAlignment="Left" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding HashText}"
                               FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{StaticResource Txt4}" Margin="0,6,0,0"
                               HorizontalAlignment="Left" />

                    <ProgressBar Grid.Row="3" Grid.Column="0" Height="4" Margin="0,10,0,0"
                                 Minimum="0" Maximum="100" Value="{Binding Progress}"
                                 IsVisible="{Binding IsDownloading}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding Note}" Classes="meta"
                               Margin="0,7,0,0" TextWrapping="Wrap" MaxWidth="600"
                               HorizontalAlignment="Left"
                               IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <StackPanel Grid.Row="0" Grid.RowSpan="5" Grid.Column="1"
                                Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Classes="toolbtn" Content="Download"
                              Command="{Binding Download}" IsVisible="{Binding IsMissing}" />
                      <Button Classes="toolbtn" Content="Stop"
                              Command="{Binding Cancel}" IsVisible="{Binding IsDownloading}" />
                      <TextBlock Text="Downloaded" Classes="meta" VerticalAlignment="Center"
                                 Foreground="{StaticResource GreenLight}"
                                 IsVisible="{Binding IsDownloaded}" />
                      <Button Classes="ghost" Content="Remove" Width="78"
                              Command="{Binding Remove}" IsVisible="{Binding CanRemove}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
