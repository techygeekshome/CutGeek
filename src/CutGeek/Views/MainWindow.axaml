<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CutGeek.ViewModels"
        xmlns:views="clr-namespace:CutGeek.Views"
        x:Class="CutGeek.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="CutGeek"
        Width="1180" Height="940" MinWidth="860" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Navy}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13.5"
        DragDrop.AllowDrop="True">

  <Window.Styles>
    <StyleInclude Source="avares://CutGeek/Themes/Shell.axaml" />
  </Window.Styles>

  <Grid ColumnDefinitions="212,*">

    <Border Grid.Column="0" Background="{StaticResource Chrome}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="12,16">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,18">
          <Image Source="avares://CutGeek/Assets/cutgeek.png"
                 Width="36" Height="36" VerticalAlignment="Center" />
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding BrandName}" FontSize="17" FontWeight="Bold" />
            <TextBlock Text="{Binding BrandBy}" FontSize="11"
                       Foreground="{StaticResource Txt3}" Margin="0,1,0,0" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="2">
          <Button Classes="nav" Classes.on="{Binding IsCutOut}"
                  Command="{Binding ShowCutOut}" Content="Cut out" />
          <Button Classes="nav" Classes.on="{Binding IsModels}"
                  Command="{Binding ShowModels}" Content="Models" />
          <Button Classes="nav" Classes.on="{Binding IsSettings}"
                  Command="{Binding ShowSettings}" Content="Settings" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="7">
          <Button Classes="ghost" Content="Check for updates" Click="OnCheckUpdates" />
          <Button Classes="ghost" Content="About" Click="OnAbout" />
          <TextBlock Text="{Binding VersionText, StringFormat='v{0}'}"
                     FontSize="11" Foreground="{StaticResource Txt4}"
                     HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*">

      <Border Grid.Row="0" Padding="26,26,26,15"
              BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="{Binding PageTitle}" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatusLine}" Classes="sub"
                       FontSize="12.5" Margin="0,4,0,0" MaxWidth="620"
                       HorizontalAlignment="Left" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                      VerticalAlignment="Center" IsVisible="{Binding IsCutOut}">
            <ProgressBar Width="120" Height="4" IsIndeterminate="True"
                         Foreground="{StaticResource BlueLight}"
                         VerticalAlignment="Center"
                         IsVisible="{Binding IsRunning}" />
            <Button Classes="toolbtn" Content="Add images…" Click="OnAddFiles"
                    IsEnabled="{Binding NotRunning}" />
            <Button Classes="toolbtn" Content="Clear finished" Click="OnClearFinished"
                    IsEnabled="{Binding NotRunning}" />
            <Button Classes="danger" Content="Stop" Click="OnStop"
                    IsVisible="{Binding IsRunning}" />
            <Button Classes="primary" Content="Cut out" Click="OnStart"
                    IsVisible="{Binding NotRunning}"
                    IsEnabled="{Binding CanStart}" />
          </StackPanel>
        </Grid>
      </Border>

      <Panel Grid.Row="1">
        <views:CutOutView IsVisible="{Binding IsCutOut}" />
        <views:ModelsView IsVisible="{Binding IsModels}" />
        <views:SettingsView IsVisible="{Binding IsSettings}" />
      </Panel>
    </Grid>
  </Grid>
</Window>
